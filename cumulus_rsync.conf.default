# Cumulus Rsync Configuration File

# Local host and port
local.host = 0.0.0.0
local.port = 8800

# Information about the controller, where cumulus_server is running
storage.host = 127.0.0.1
storage.path = /storage
storage.port = 8800
storage.user = me
# Path to the public key used to authenticate with the controller (no password)
storage.public_key = cumulus.pem

# Path to the RSync and SSH binary folders (if values are not pointing to existing folders, they will be considered in the PATH already)
rsync.bin.path = path/to/rsync/bin/
ssh.bin.path = path/to/ssh/bin/
# Refresh rate in seconds, used to regularly check if there are files to transfer
refresh.rate = 15
# File used to indicate to the server that all the files have been transferred for a given job
final.file = .cumulus.rsync
# Log file of RSync, used to track the progress of the transfers
progress.file = .cumulus.progress
# SQLite file used to store the queue of files to transfer
queue.file = cumulus_rsync_queue.db

# Cumulus RSync agent version number
version = 1.0.1

# Survey configuration
survey.enabled = false
survey.time = 23:00
survey.depth = 1
survey.astral.dir = D:/path/to/astral/data
survey.astral.regex = AT.*.raw
survey.astral.isfile = true
survey.timstofpro.dir = D:/path/to/timstofpro/data
survey.timstofpro.regex = TP.*.d
survey.timstofpro.isfile = false